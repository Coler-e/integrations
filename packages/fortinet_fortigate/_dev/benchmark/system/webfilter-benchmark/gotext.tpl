{{- $timestamp := generate "timestamp" -}}
{{- $date := $timestamp.Format "2006-01-02" -}}
{{- $time := $timestamp.Format "15:04:05" -}}
{{- $eventtime := $timestamp.UnixNano -}}
{{- $pri := generate "pri" -}}
{{- $devname := generate "devname" -}}
{{- $devid := generate "devid" -}}
{{- $logid := generate "logid_webfilter" -}}
{{- $eventtype := generate "eventtype" -}}
{{- $level := generate "level_webfilter" -}}
{{- $vd := generate "vd" -}}
{{- $tz := generate "tz" -}}
{{- $policyid := generate "policyid" -}}
{{- $sessionid := generate "sessionid" -}}
{{- $user := generate "user" -}}
{{- $srcip := generate "srcip" -}}
{{- $srcport := generate "srcport" -}}
{{- $srcintf := generate "srcintf" -}}
{{- $srcintfrole := generate "srcintfrole" -}}
{{- $dstip := generate "dstip" -}}
{{- $dstport := generate "dstport" -}}
{{- $dstintf := generate "dstintf" -}}
{{- $proto := generate "proto_web" -}}
{{- $service := generate "service_web" -}}
{{- $hostname := generate "hostname" -}}
{{- $profile := generate "profile" -}}
{{- $action := generate "action_web" -}}
{{- $url := generate "url" -}}
{{- $sentbyte := generate "sentbyte" -}}
{{- $rcvdbyte := generate "rcvdbyte" -}}
{{- $cat := generate "cat" -}}
{{- $catdesc := generate "catdesc" -}}
<{{$pri}}>date={{$date}} time={{$time}} devname="{{$devname}}" devid="{{$devid}}" logid="{{$logid}}" type="utm" subtype="webfilter" eventtype="{{$eventtype}}" level="{{$level}}" vd="{{$vd}}" eventtime={{$eventtime}} tz="{{$tz}}" policyid={{$policyid}} sessionid={{$sessionid}} user="{{$user}}" srcip={{$srcip}} srcport={{$srcport}} srcintf="{{$srcintf}}" srcintfrole="{{$srcintfrole}}" dstip={{$dstip}} dstport=443 dstintf="{{$dstintf}}" dstintfrole="wan" proto={{$proto}} service="{{$service}}" hostname="{{$hostname}}" profile="{{$profile}}" action="{{$action}}" reqtype="direct" url="{{$url}}" sentbyte={{$sentbyte}} rcvdbyte={{$rcvdbyte}} direction="outgoing" msg="URL belongs to a denied category in policy" method="domain" cat={{$cat}} catdesc="{{$catdesc}}"
