{{- $appcat := generate "appcat" -}}
<{{$pri}}>date={{$date}} time={{$time}} devname="{{$devname}}" devid="{{$devid}}" logid="{{$logid}}" type="traffic" subtype="{{$subtype}}" level="{{$level}}" vd="{{$vd}}" eventtime={{$eventtime}} srcip={{$srcip}} srcport={{$srcport}} srcintf="{{$srcintf}}" srcintfrole="{{$srcintfrole}}" dstip={{$dstip}} dstport={{$dstport}} dstintf="{{$dstintf}}" dstintfrole="{{$dstintfrole}}" sessionid={{$sessionid}} proto={{$proto}} action="{{$action}}" policyid={{$policyid}} policytype="policy" service="{{$service}}" dstcountry="{{$dstcountry}}" srccountry="{{$srccountry}}" trandisp="noop" duration={{$duration}} sentbyte={{$sentbyte}} rcvdbyte={{$rcvdbyte}} sentpkt={{$sentpkt}} rcvdpkt={{$rcvdpkt}} appcat="{{$appcat}}"
